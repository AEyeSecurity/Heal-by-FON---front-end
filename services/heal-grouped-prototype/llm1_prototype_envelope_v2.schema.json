{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HEAL LLM1 Prototype Envelope V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "payload_v7", "scientific_decision", "runtime_variant_gate", "technical_gates", "coverage_status", "readiness", "allowlists", "provenance", "prototype_hashes"],
  "properties": {
    "schema_version": {"const": "llm1_prototype_envelope_v2"},
    "payload_v7": {"type": "object"},
    "scientific_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "core_status", "scientific_inference_ceiling", "effective_runtime_ceiling", "dominant_direction", "material_conflict", "limitations"],
      "properties": {
        "group_id": {"type": "string"},
        "core_status": {"enum": ["approved", "approved_with_conflict", "withheld", "rejected"]},
        "scientific_inference_ceiling": {"enum": ["none", "context_only", "initial_guide_candidate"]},
        "effective_runtime_ceiling": {"enum": ["none", "context_only", "initial_guide_candidate"]},
        "dominant_direction": {"type": "string"},
        "material_conflict": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_records": {"type": "array", "items": {"type": "object"}}
      }
    },
    "runtime_variant_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "reason_codes", "variant_refs", "evidence_ids"],
      "properties": {
        "eligible": {"type": "boolean"},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "variant_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "technical_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "input_completeness", "evidence_allowlist", "variant_allowlist", "payload_schema"],
      "properties": {
        "identity": {"type": "boolean"},
        "input_completeness": {"type": "boolean"},
        "evidence_allowlist": {"type": "boolean"},
        "variant_allowlist": {"type": "boolean"},
        "payload_schema": {"type": "boolean"}
      }
    },
    "coverage_status": {"const": "covered_by_prototype_snapshot"},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prototype_readiness", "formal_validation_readiness"],
      "properties": {
        "prototype_readiness": {"const": "approved_for_sandbox_smoke_test"},
        "formal_validation_readiness": {"const": "pending_new_unseen_holdout"}
      }
    },
    "allowlists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scientific_evidence_ids", "runtime_evidence_ids", "evidence_ids", "variant_refs", "focus_variant_refs"],
      "properties": {
        "scientific_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "runtime_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "variant_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "focus_variant_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_signature", "allowlist", "legacy_curation_override_scope"],
      "properties": {
        "decision_signature": {"type": "string"},
        "allowlist": {"type": "string"},
        "legacy_curation_override_scope": {"const": "curation_fields_only"}
      }
    },
    "prototype_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_manifest", "snapshot", "payload", "packet"],
      "properties": {
        "candidate_manifest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "snapshot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "payload": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "packet": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
