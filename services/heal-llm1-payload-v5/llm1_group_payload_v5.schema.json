{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healbyfon.local/schemas/llm1_group_payload_v5.schema.json",
  "title": "HEAL LLM1 grouped payload v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_schema_version",
    "execution_mode",
    "group_id",
    "gene",
    "module_id",
    "group_context",
    "canonical_status",
    "curated_mechanism",
    "focus_variant_evidence",
    "clinical_evidence_summary",
    "gwas_evidence_summary",
    "publication_evidence_digest",
    "supporting_context",
    "transcript_discordant_context",
    "identity_unresolved",
    "source_failures",
    "deterministic_summary",
    "evidence_coverage",
    "compression_metadata",
    "provenance",
    "gates"
  ],
  "properties": {
    "payload_schema_version": { "const": "llm1_group_payload_v5" },
    "execution_mode": { "enum": ["dry_run", "pilot"] },
    "group_id": { "type": "string", "minLength": 3 },
    "gene": { "type": "string", "minLength": 1 },
    "module_id": { "type": "string", "minLength": 1 },
    "group_context": { "type": "object" },
    "canonical_status": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "curated_mechanism": {
      "type": "object",
      "required": ["curation_status", "usable_by_llm"],
      "properties": {
        "curation_status": { "type": "string" },
        "usable_by_llm": { "type": "boolean" }
      }
    },
    "focus_variant_evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["evidence_id", "variant_ref", "variant_key", "source", "identity_match_class", "functional_evidence", "source_statuses"]
      }
    },
    "clinical_evidence_summary": { "type": "object" },
    "gwas_evidence_summary": { "type": "object" },
    "publication_evidence_digest": { "type": "object" },
    "supporting_context": { "type": "object" },
    "transcript_discordant_context": { "type": "object" },
    "identity_unresolved": { "type": "object" },
    "source_failures": { "type": "object" },
    "deterministic_summary": { "type": "object" },
    "evidence_coverage": {
      "type": "object",
      "required": ["records_total", "status_counts", "reconciled", "ledger_artifact"],
      "properties": {
        "records_total": { "type": "integer", "minimum": 0 },
        "status_counts": { "type": "object" },
        "reconciled": { "const": true },
        "ledger_artifact": { "type": "string" }
      }
    },
    "compression_metadata": {
      "type": "object",
      "required": ["strategy", "estimated_tokens", "budget_status", "target_tokens", "hard_limit_tokens", "generative_digest_used"],
      "properties": {
        "strategy": { "type": "string" },
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "budget_status": {
          "enum": ["within_target", "large_but_allowed", "requires_hierarchical_compression", "compression_review_required"]
        },
        "target_tokens": { "const": 15000 },
        "hard_limit_tokens": { "const": 25000 },
        "generative_digest_used": { "type": "boolean" }
      }
    },
    "provenance": { "type": "object" },
    "gates": {
      "type": "object",
      "required": [
        "evidence_ledger_complete",
        "evidence_packet_ready",
        "token_budget_ready",
        "digest_validated",
        "mechanism_registry_ready",
        "source_errors_acceptable_for_pilot",
        "group_payload_ready",
        "llm1_pilot_ready"
      ]
    }
  }
}
