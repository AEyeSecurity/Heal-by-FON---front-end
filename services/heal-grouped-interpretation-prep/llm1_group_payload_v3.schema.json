{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healbyfon.local/schemas/llm1_group_payload_v3.schema.json",
  "title": "HEAL LLM1 grouped payload v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_schema_version",
    "dry_run_only",
    "group_id",
    "gene",
    "module_id",
    "group_context",
    "canonical_status",
    "genetic_facts",
    "scientific_evidence",
    "curated_mechanisms",
    "deterministic_summary",
    "focus_variants",
    "context_variants",
    "unresolved_and_failed",
    "provenance"
  ],
  "properties": {
    "payload_schema_version": { "const": "llm1_group_payload_v3" },
    "dry_run_only": { "const": true },
    "group_id": { "type": "string", "minLength": 3 },
    "gene": { "type": "string", "minLength": 1 },
    "module_id": { "type": "string", "minLength": 1 },
    "group_context": { "type": "object" },
    "canonical_status": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "genetic_facts": { "type": "array", "items": { "type": "object" } },
    "scientific_evidence": { "type": "array", "items": { "type": "object" } },
    "curated_mechanisms": {
      "type": "object",
      "required": ["curation_status", "usable_by_llm"],
      "properties": {
        "curation_status": { "type": "string" },
        "usable_by_llm": { "type": "boolean" }
      }
    },
    "deterministic_summary": { "type": "object" },
    "focus_variants": { "type": "array", "maxItems": 20, "items": { "type": "object" } },
    "context_variants": { "type": "object" },
    "unresolved_and_failed": { "type": "object" },
    "provenance": { "type": "object" }
  }
}
